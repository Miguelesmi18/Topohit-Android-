<?xml version="1.0" encoding="utf-8"?>
<!-- Una gráfica de «Mis estadísticas»: título e imagen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/separacion_mini"
    android:background="@drawable/fila"
    android:orientation="vertical"
    android:padding="@dimen/separacion_pequena">

    <TextView
        android:id="@+id/LblListGraficaTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/marron"
        android:textSize="@dimen/texto_normal"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ImgListGraficaImagen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />
</LinearLayout>
