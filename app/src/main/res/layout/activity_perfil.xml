<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_partida_normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/margen_pequeno">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnAtras"
                style="@style/BotonRedondo"
                android:text="@string/atras" />

            <TextView
                android:id="@+id/lblTitulo"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:shadowColor="@color/blanco"
                android:shadowRadius="8"
                android:text="@string/mi_perfil" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:orientation="horizontal">

            <!-- Izquierda: avatar y botones -->
            <LinearLayout
                android:id="@+id/layPanelJugador"
                android:layout_width="250dp"
                android:layout_height="match_parent"
                android:background="@drawable/panel_crema"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:background="@drawable/circulo_crema"
                    android:padding="16dp"
                    android:src="@drawable/topo_normal_03_feliz" />

                <TextView
                    android:id="@+id/lblNombre"
                    style="@style/Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Nombre"
                    android:textSize="@dimen/texto_titulo_pequeno" />

                <TextView
                    android:id="@+id/lblRol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/marron"
                    android:textSize="@dimen/texto_pequeno" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnCambiarAvatar"
                    style="@style/BotonJuego"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/alto_boton_pequeno"
                    android:background="@drawable/btn_verde"
                    android:text="@string/cambiar_avatar"
                    android:textSize="@dimen/texto_normal" />

                <TextView
                    android:id="@+id/btnCerrarSesion"
                    style="@style/BotonJuego"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/alto_boton_pequeno"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_rojo"
                    android:text="@string/cerrar_sesion"
                    android:textSize="@dimen/texto_normal" />
            </LinearLayout>

            <!-- Derecha: datos e historial -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/margen_pequeno"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layDatoPartidas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="@drawable/dato"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/lblPartidas"
                    style="@style/DatoNumero"
                    android:text="-" />

                <TextView
                    style="@style/DatoEtiqueta"
                    android:text="Partidas" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layDatoRecordCr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="@drawable/dato"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/lblRecordCr"
                    style="@style/DatoNumero"
                    android:text="-" />

                <TextView
                    style="@style/DatoEtiqueta"
                    android:text="Récord CR" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layDatoRecordInf"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="@drawable/dato"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/lblRecordInf"
                    style="@style/DatoNumero"
                    android:text="-" />

                <TextView
                    style="@style/DatoEtiqueta"
                    android:text="Récord Inf." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layDatoEstrellas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="@drawable/dato"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/lblEstrellas"
                    style="@style/DatoNumero"
                    android:text="-" />

                <TextView
                    style="@style/DatoEtiqueta"
                    android:text="Estrellas" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layDatoPrecision"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="@drawable/dato"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/lblPrecision"
                    style="@style/DatoNumero"
                    android:text="-" />

                <TextView
                    style="@style/DatoEtiqueta"
                    android:text="Precisión" />
            </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layPanelHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/margen_pequeno"
                    android:layout_weight="1"
                    android:background="@drawable/panel_crema"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/lblHistorial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/historial"
                        android:textColor="@color/marron"
                        android:textSize="@dimen/texto_grande" />

                    <TextView
                        android:id="@+id/lblVacio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:text="Cargando..."
                        android:textColor="@color/marron"
                        android:textSize="@dimen/texto_normal" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/lstHistorial"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Elegir otro avatar ===== -->
    <FrameLayout
        android:id="@+id/layAvatares"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/oscurecer"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layPanelAvatares"
            android:layout_width="520dp"
            android:layout_height="480dp"
            android:layout_gravity="center"
            android:background="@drawable/panel_crema"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/lblElige"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/elige_avatar"
                android:textSize="@dimen/texto_titulo_pequeno" />

            <include
                android:id="@+id/selAvatares"
                layout="@layout/selector_avatares"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnGuardarAvatar"
                style="@style/BotonJuego"
                android:layout_width="240dp"
                android:layout_height="@dimen/alto_boton_pequeno"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_naranja"
                android:text="@string/guardar"
                android:textSize="@dimen/texto_normal" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
