<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil: avatar y botones a la izquierda; resumen e historial a la derecha; capa para cambiar el avatar -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ImgPerfilFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_partida_normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/margen_pequeno">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/BtnPerfilAtras"
                style="@style/BotonRedondo"
                android:contentDescription="@string/volver"
                android:text="@string/atras" />

            <TextView
                android:id="@+id/LblPerfilCabecera"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:shadowColor="@color/blanco"
                android:shadowRadius="8"
                android:text="@string/mi_perfil" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/LayPerfilJugador"
                android:layout_width="@dimen/ancho_panel_jugador"
                android:layout_height="match_parent"
                android:background="@drawable/panel_crema"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/separacion">

                <ImageView
                    android:id="@+id/ImgPerfilAvatar"
                    android:layout_width="@dimen/avatar_grande"
                    android:layout_height="@dimen/avatar_grande"
                    android:background="@drawable/circulo_crema"
                    android:contentDescription="@string/tu_avatar"
                    android:padding="@dimen/separacion"
                    android:src="@drawable/topo_normal_03_feliz" />

                <TextView
                    android:id="@+id/LblPerfilNombre"
                    style="@style/Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/separacion_pequena"
                    android:textSize="@dimen/texto_titulo_pequeno" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/BtnPerfilEstadisticas"
                    style="@style/BotonJuego"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/alto_boton_pequeno"
                    android:layout_marginBottom="@dimen/margen_pequeno"
                    android:background="@drawable/btn_naranja"
                    android:text="@string/mis_estadisticas"
                    android:textSize="@dimen/texto_normal" />

                <TextView
                    android:id="@+id/BtnPerfilCambiarAvatar"
                    style="@style/BotonJuego"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/alto_boton_pequeno"
                    android:background="@drawable/btn_verde"
                    android:text="@string/cambiar_avatar"
                    android:textSize="@dimen/texto_normal" />

                <TextView
                    android:id="@+id/BtnPerfilCerrarSesion"
                    style="@style/BotonJuego"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/alto_boton_pequeno"
                    android:layout_marginTop="@dimen/margen_pequeno"
                    android:background="@drawable/btn_rojo"
                    android:text="@string/cerrar_sesion"
                    android:textSize="@dimen/texto_normal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/margen_pequeno"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/CajaDato">

                        <TextView
                            android:id="@+id/LblPerfilPartidas"
                            style="@style/DatoNumero"
                            android:text="@string/sin_dato" />

                        <TextView
                            style="@style/DatoEtiqueta"
                            android:text="@string/partidas" />
                    </LinearLayout>

                    <LinearLayout style="@style/CajaDato">

                        <TextView
                            android:id="@+id/LblPerfilRecord"
                            style="@style/DatoNumero"
                            android:text="@string/sin_dato" />

                        <TextView
                            style="@style/DatoEtiqueta"
                            android:text="@string/record_minuscula" />
                    </LinearLayout>

                    <LinearLayout style="@style/CajaDato">

                        <TextView
                            android:id="@+id/LblPerfilPrecision"
                            style="@style/DatoNumero"
                            android:text="@string/sin_dato" />

                        <TextView
                            style="@style/DatoEtiqueta"
                            android:text="@string/precision" />
                    </LinearLayout>

                    <LinearLayout style="@style/CajaDato">

                        <TextView
                            android:id="@+id/LblPerfilMinutos"
                            style="@style/DatoNumero"
                            android:text="@string/sin_dato" />

                        <TextView
                            style="@style/DatoEtiqueta"
                            android:text="@string/minutos_jugados" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/LayPerfilHistorial"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/margen_pequeno"
                    android:layout_weight="1"
                    android:background="@drawable/panel_crema"
                    android:orientation="vertical"
                    android:padding="@dimen/separacion">

                    <TextView
                        android:id="@+id/LblPerfilHistorialTitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/historial"
                        android:textColor="@color/marron"
                        android:textSize="@dimen/texto_grande" />

                    <TextView
                        android:id="@+id/LblPerfilVacio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margen"
                        android:gravity="center"
                        android:text="@string/cargando"
                        android:textColor="@color/marron"
                        android:textSize="@dimen/texto_normal" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/LstPerfilHistorial"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/separacion_pequena"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Elegir otro avatar ===== -->
    <FrameLayout
        android:id="@+id/LayPerfilAvatares"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/oscurecer"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/LayPerfilPanelAvatares"
            android:layout_width="@dimen/ancho_panel_avatares"
            android:layout_height="@dimen/alto_panel_avatares"
            android:layout_gravity="center"
            android:background="@drawable/panel_crema"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/separacion">

            <TextView
                android:id="@+id/LblPerfilElige"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/elige_avatar"
                android:textSize="@dimen/texto_titulo_pequeno" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/LstPerfilAvatares"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/separacion_pequena"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_pequena"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/BtnPerfilCerrarAvatares"
                    style="@style/BotonJuego"
                    android:layout_width="@dimen/ancho_boton_pequeno"
                    android:layout_height="@dimen/alto_boton_pequeno"
                    android:layout_marginEnd="@dimen/margen_pequeno"
                    android:background="@drawable/btn_gris"
                    android:text="@string/cancelar"
                    android:textSize="@dimen/texto_normal" />

                <TextView
                    android:id="@+id/BtnPerfilGuardarAvatar"
                    style="@style/BotonJuego"
                    android:layout_width="@dimen/ancho_boton_pequeno"
                    android:layout_height="@dimen/alto_boton_pequeno"
                    android:background="@drawable/btn_naranja"
                    android:text="@string/guardar"
                    android:textSize="@dimen/texto_normal" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
