<?xml version="1.0" encoding="utf-8"?>
<!-- Fin de la partida: puntos, récord, datos de la partida y si se ha abierto otra dificultad -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ImgResultadoFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_partida_normal" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/oscurecer" />

    <LinearLayout
        android:id="@+id/LayResultadoPanel"
        android:layout_width="@dimen/ancho_panel_resultado"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/panel_crema"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/relleno_panel_pequeno">

        <TextView
            android:id="@+id/LblResultadoTitulo"
            style="@style/Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/resultado_titulo" />

        <TextView
            android:id="@+id/LblResultadoNuevoRecord"
            style="@style/Chip"
            android:layout_marginTop="@dimen/separacion_mini"
            android:text="@string/nuevo_record"
            android:visibility="gone" />

        <TextView
            android:id="@+id/LblResultadoPuntos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/marron"
            android:textSize="@dimen/texto_puntos" />

        <TextView
            android:id="@+id/LblResultadoSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/marron"
            android:textSize="@dimen/texto_normal"
            android:textStyle="bold" />

        <!-- ¡Has desbloqueado Normal! (solo si la API confirma que se ha abierto) -->
        <TextView
            android:id="@+id/LblResultadoDesbloqueo"
            style="@style/Chip"
            android:layout_marginTop="@dimen/separacion_pequena"
            android:background="@drawable/chip_verde"
            android:textSize="@dimen/texto_normal"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/separacion"
            android:orientation="horizontal">

            <LinearLayout style="@style/CajaDato">

                <TextView
                    android:id="@+id/LblResultadoAciertos"
                    style="@style/DatoNumero" />

                <TextView
                    style="@style/DatoEtiqueta"
                    android:text="@string/aciertos" />
            </LinearLayout>

            <LinearLayout style="@style/CajaDato">

                <TextView
                    android:id="@+id/LblResultadoFallos"
                    style="@style/DatoNumero" />

                <TextView
                    style="@style/DatoEtiqueta"
                    android:text="@string/fallos" />
            </LinearLayout>

            <LinearLayout style="@style/CajaDato">

                <TextView
                    android:id="@+id/LblResultadoEscapados"
                    style="@style/DatoNumero" />

                <TextView
                    style="@style/DatoEtiqueta"
                    android:text="@string/escapados" />
            </LinearLayout>

            <LinearLayout style="@style/CajaDato">

                <TextView
                    android:id="@+id/LblResultadoDorados"
                    style="@style/DatoNumero" />

                <TextView
                    style="@style/DatoEtiqueta"
                    android:text="@string/dorados" />
            </LinearLayout>

            <LinearLayout style="@style/CajaDato">

                <TextView
                    android:id="@+id/LblResultadoRacha"
                    style="@style/DatoNumero" />

                <TextView
                    style="@style/DatoEtiqueta"
                    android:text="@string/mejor_racha" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/LblResultadoGuardado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/separacion_pequena"
            android:text="@string/resultado_guardando"
            android:textColor="@color/marron"
            android:textSize="@dimen/texto_pequeno" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/separacion"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/BtnResultadoRepetir"
                style="@style/BotonFila"
                android:background="@drawable/btn_naranja"
                android:text="@string/repetir" />

            <TextView
                android:id="@+id/BtnResultadoDificultades"
                style="@style/BotonFila"
                android:background="@drawable/btn_verde"
                android:text="@string/dificultades" />

            <TextView
                android:id="@+id/BtnResultadoMenu"
                style="@style/BotonFila"
                android:background="@drawable/btn_verde"
                android:text="@string/menu" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/ImgResultadoTopo"
        android:layout_width="@dimen/topo_resultado_ancho"
        android:layout_height="@dimen/topo_resultado_alto"
        android:layout_gravity="bottom|end"
        android:contentDescription="@null"
        android:src="@drawable/topo_normal_07_burlon" />
</FrameLayout>
