<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_partida_normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/margen_pequeno">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnAtras"
                style="@style/BotonRedondo"
                android:text="@string/atras" />

            <TextView
                android:id="@+id/lblTitulo"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:shadowColor="@color/blanco"
                android:shadowRadius="8"
                android:text="@string/ajustes" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/layPanel"
            android:layout_width="760dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/margen"
            android:background="@drawable/panel_crema"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Temática -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblTematica"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/tematica"
                    android:textColor="@color/marron"
                    android:textSize="@dimen/texto_grande" />

                <TextView
                    android:id="@+id/btnTemaNormal"
                    style="@style/BotonJuego"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/alto_boton_pequeno"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_verde"
                    android:text="@string/normal"
                    android:textSize="@dimen/texto_normal" />

                <TextView
                    android:id="@+id/btnTemaHalloween"
                    style="@style/BotonJuego"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/alto_boton_pequeno"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_morado"
                    android:text="@string/halloween"
                    android:textSize="@dimen/texto_normal" />

                <TextView
                    android:id="@+id/btnTemaNavidad"
                    style="@style/BotonJuego"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/alto_boton_pequeno"
                    android:layout_weight="1"
                    android:background="@drawable/btn_rojo"
                    android:text="@string/navidad"
                    android:textSize="@dimen/texto_normal" />
            </LinearLayout>

            <!-- Sonido: música de fondo y efectos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblSonido"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/sonido"
                    android:textColor="@color/marron"
                    android:textSize="@dimen/texto_grande" />

                <TextView
                    android:id="@+id/btnMusica"
                    style="@style/BotonJuego"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/alto_boton_pequeno"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_naranja"
                    android:text="@string/musica"
                    android:textSize="@dimen/texto_normal" />

                <TextView
                    android:id="@+id/btnEfectos"
                    style="@style/BotonJuego"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/alto_boton_pequeno"
                    android:layout_weight="1"
                    android:background="@drawable/btn_naranja"
                    android:text="@string/efectos"
                    android:textSize="@dimen/texto_normal" />
            </LinearLayout>

            <!-- Sesión -->
            <LinearLayout
                android:id="@+id/laySesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblUsuario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/marron"
                    android:textSize="@dimen/texto_normal" />

                <TextView
                    android:id="@+id/btnCerrarSesion"
                    style="@style/BotonJuego"
                    android:layout_width="260dp"
                    android:layout_height="@dimen/alto_boton_pequeno"
                    android:background="@drawable/btn_rojo"
                    android:text="@string/cerrar_sesion"
                    android:textSize="@dimen/texto_normal" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
