<?xml version="1.0" encoding="utf-8"?>
<!-- Ajustes: temática, sonido y sesión -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ImgAjustesFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_partida_normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/margen_pequeno">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/BtnAjustesAtras"
                style="@style/BotonRedondo"
                android:contentDescription="@string/volver"
                android:text="@string/atras" />

            <TextView
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:shadowColor="@color/blanco"
                android:shadowRadius="8"
                android:text="@string/ajustes" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/LayAjustesPanel"
            android:layout_width="@dimen/ancho_panel_ajustes"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/margen"
            android:background="@drawable/panel_crema"
            android:orientation="vertical"
            android:padding="@dimen/relleno_panel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/LblAjustesTematica"
                    style="@style/EtiquetaAjuste"
                    android:text="@string/tematica" />

                <TextView
                    android:id="@+id/BtnAjustesTemaNormal"
                    style="@style/BotonTema"
                    android:layout_marginEnd="@dimen/separacion_pequena"
                    android:background="@drawable/btn_verde"
                    android:textColor="@color/marron"
                    android:text="@string/normal" />

                <TextView
                    android:id="@+id/BtnAjustesTemaHalloween"
                    style="@style/BotonTema"
                    android:layout_marginEnd="@dimen/separacion_pequena"
                    android:background="@drawable/btn_morado"
                    android:text="@string/halloween" />

                <TextView
                    android:id="@+id/BtnAjustesTemaNavidad"
                    style="@style/BotonTema"
                    android:background="@drawable/btn_rojo"
                    android:text="@string/navidad" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/relleno_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/LblAjustesSonido"
                    style="@style/EtiquetaAjuste"
                    android:text="@string/sonido" />

                <TextView
                    android:id="@+id/BtnAjustesMusica"
                    style="@style/BotonTema"
                    android:layout_marginEnd="@dimen/separacion_pequena"
                    android:background="@drawable/btn_naranja"
                    android:text="@string/musica"
                    android:textColor="@color/marron" />

                <TextView
                    android:id="@+id/BtnAjustesEfectos"
                    style="@style/BotonTema"
                    android:background="@drawable/btn_naranja"
                    android:text="@string/efectos"
                    android:textColor="@color/marron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LayAjustesSesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/relleno_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/LblAjustesUsuario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/marron"
                    android:textSize="@dimen/texto_normal" />

                <TextView
                    android:id="@+id/BtnAjustesCerrarSesion"
                    style="@style/BotonJuego"
                    android:layout_width="@dimen/ancho_boton_mediano"
                    android:layout_height="@dimen/alto_boton_pequeno"
                    android:background="@drawable/btn_rojo"
                    android:text="@string/cerrar_sesion"
                    android:textSize="@dimen/texto_normal" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
