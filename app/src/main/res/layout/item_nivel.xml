<?xml version="1.0" encoding="utf-8"?>
<!-- Un nivel del mapa: círculo con el número y sus estrellas debajo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/btnNivel"
        android:layout_width="@dimen/nivel"
        android:layout_height="@dimen/nivel"
        android:background="@drawable/circulo_naranja"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:paddingBottom="4dp"
        android:shadowColor="@color/marron"
        android:shadowDy="3"
        android:shadowRadius="2"
        android:text="1"
        android:textColor="@color/blanco"
        android:textSize="32sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgEstrella1"
            android:layout_width="@dimen/estrella_mini"
            android:layout_height="@dimen/estrella_mini"
            android:src="@drawable/estrella_vacia" />

        <ImageView
            android:id="@+id/imgEstrella2"
            android:layout_width="@dimen/estrella_mini"
            android:layout_height="@dimen/estrella_mini"
            android:src="@drawable/estrella_vacia" />

        <ImageView
            android:id="@+id/imgEstrella3"
            android:layout_width="@dimen/estrella_mini"
            android:layout_height="@dimen/estrella_mini"
            android:src="@drawable/estrella_vacia" />
    </LinearLayout>
</LinearLayout>
