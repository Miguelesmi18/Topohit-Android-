<?xml version="1.0" encoding="utf-8"?>
<!-- Cómo jugar: 3 pasos con dibujos y el botón ¡A JUGAR! -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ImgComoJugarFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_partida_normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/margen_pequeno">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/BtnComoJugarAtras"
                style="@style/BotonRedondo"
                android:contentDescription="@string/volver"
                android:text="@string/atras" />

            <TextView
                android:id="@+id/LblComoJugarCabecera"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:shadowColor="@color/blanco"
                android:shadowRadius="8"
                android:text="@string/como_jugar" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/margen_tarjetas"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:layout_marginRight="@dimen/margen_tarjetas"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Paso 1 -->
            <LinearLayout
                android:id="@+id/LayComoJugarPaso1"
                style="@style/TarjetaPaso">

                <TextView
                    style="@style/NumeroPaso"
                    android:text="@string/uno" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ImgComoJugarPaso1a"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="@string/topo_normal" />

                    <ImageView
                        android:id="@+id/ImgComoJugarPaso1b"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:contentDescription="@string/topo_enfadado" />
                </LinearLayout>

                <TextView
                    android:id="@+id/LblComoJugarTitulo1"
                    style="@style/TituloPaso"
                    android:text="@string/como_paso1_titulo" />

                <TextView
                    android:id="@+id/LblComoJugarTexto1"
                    style="@style/TextoPaso" />
            </LinearLayout>

            <!-- Paso 2 -->
            <LinearLayout
                android:id="@+id/LayComoJugarPaso2"
                style="@style/TarjetaPaso">

                <TextView
                    style="@style/NumeroPaso"
                    android:text="@string/dos" />

                <ImageView
                    android:id="@+id/ImgComoJugarPaso2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/bomba" />

                <TextView
                    android:id="@+id/LblComoJugarTitulo2"
                    style="@style/TituloPaso"
                    android:text="@string/como_paso2_titulo" />

                <TextView
                    android:id="@+id/LblComoJugarTexto2"
                    style="@style/TextoPaso"
                    android:text="@string/como_paso2_texto" />
            </LinearLayout>

            <!-- Paso 3 -->
            <LinearLayout
                android:id="@+id/LayComoJugarPaso3"
                style="@style/TarjetaPaso">

                <TextView
                    style="@style/NumeroPaso"
                    android:text="@string/tres" />

                <ImageView
                    android:id="@+id/ImgComoJugarPaso3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/topo_dorado" />

                <TextView
                    android:id="@+id/LblComoJugarTitulo3"
                    style="@style/TituloPaso"
                    android:text="@string/como_paso3_titulo" />

                <TextView
                    android:id="@+id/LblComoJugarTexto3"
                    style="@style/TextoPaso" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/BtnComoJugarJugar"
            style="@style/BotonJuego"
            android:layout_width="@dimen/ancho_boton_jugar"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:background="@drawable/btn_naranja"
            android:text="@string/a_jugar" />
    </LinearLayout>
</FrameLayout>
