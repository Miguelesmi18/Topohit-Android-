<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_partida_normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/margen_pequeno">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnAtras"
                style="@style/BotonRedondo"
                android:text="@string/atras" />

            <TextView
                android:id="@+id/lblTitulo"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:shadowColor="@color/blanco"
                android:shadowRadius="8"
                android:text="@string/como_jugar" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:layout_marginRight="30dp"
            android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/layPaso1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:background="@drawable/panel_crema"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start"
                android:background="@drawable/circulo_naranja"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:paddingBottom="4dp"
                android:text="1"
                android:textColor="@color/blanco"
                android:textSize="@dimen/texto_grande" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgPaso1a"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/imgPaso1b"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/lblPasoTitulo1"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Toca los topos"
                android:textSize="@dimen/texto_grande" />

            <TextView
                android:id="@+id/lblPasoTexto1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:minLines="2"
                android:text="+10 · el enfadado necesita 2 golpes (+25)"
                android:textColor="@color/marron"
                android:textSize="@dimen/texto_normal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layPaso2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:background="@drawable/panel_crema"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start"
                android:background="@drawable/circulo_naranja"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:paddingBottom="4dp"
                android:text="2"
                android:textColor="@color/blanco"
                android:textSize="@dimen/texto_grande" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgPaso2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/lblPasoTitulo2"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¡Ojo con las bombas!"
                android:textSize="@dimen/texto_grande" />

            <TextView
                android:id="@+id/lblPasoTexto2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:minLines="2"
                android:text="−20 puntos (en Infinito, −1 vida)"
                android:textColor="@color/marron"
                android:textSize="@dimen/texto_normal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layPaso3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:background="@drawable/panel_crema"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start"
                android:background="@drawable/circulo_naranja"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:paddingBottom="4dp"
                android:text="3"
                android:textColor="@color/blanco"
                android:textSize="@dimen/texto_grande" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgPaso3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/lblPasoTitulo3"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dorado y combos"
                android:textSize="@dimen/texto_grande" />

            <TextView
                android:id="@+id/lblPasoTexto3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:minLines="2"
                android:text="Dorado +50 · 5 aciertos seguidos = x2"
                android:textColor="@color/marron"
                android:textSize="@dimen/texto_normal" />
        </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnAJugar"
            style="@style/BotonJuego"
            android:layout_width="320dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:background="@drawable/btn_naranja"
            android:text="@string/a_jugar"
            android:textSize="30sp" />
    </LinearLayout>
</FrameLayout>
