<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_partida_normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/margen_pequeno">

        <!-- Barra de arriba: atrás y título -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnAtras"
                style="@style/BotonRedondo"
                android:text="@string/atras" />

            <TextView
                android:id="@+id/lblTitulo"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:shadowColor="@color/blanco"
                android:shadowRadius="8"
                android:text="@string/elige_modo" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="@dimen/margen_pequeno"
            android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/layTarjeta1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:background="@drawable/panel_crema"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/imgModo1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/topo_normal_03_feliz" />
                <ImageView
                    android:id="@+id/imgEstrellaModo"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="top|start"
                    android:src="@drawable/estrella_llena" />
            </FrameLayout>

            <TextView
                android:id="@+id/lblTitulo1"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/historia"
                android:textSize="@dimen/texto_grande" />

            <TextView
                android:id="@+id/lblDesc1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:minLines="2"
                android:text="@string/historia_desc"
                android:textColor="@color/marron"
                android:textSize="@dimen/texto_pequeno" />

            <TextView
                android:id="@+id/btnElegir1"
                style="@style/BotonJuego"
                android:layout_width="180dp"
                android:layout_height="@dimen/alto_boton_pequeno"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_verde"
                android:text="@string/elegir"
                android:textSize="@dimen/texto_normal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layTarjeta2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:background="@drawable/panel_crema"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/imgModo2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/topo_normal_04_golpeado" />
                <ImageView
                    android:id="@+id/imgMartillo"
                    android:layout_width="64dp"
                    android:layout_height="76dp"
                    android:layout_gravity="top|end"
                    android:src="@drawable/martillo" />
            </FrameLayout>

            <TextView
                android:id="@+id/lblTitulo2"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/contrarreloj"
                android:textSize="@dimen/texto_grande" />

            <TextView
                android:id="@+id/lblDesc2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:minLines="2"
                android:text="@string/contrarreloj_desc"
                android:textColor="@color/marron"
                android:textSize="@dimen/texto_pequeno" />

            <TextView
                android:id="@+id/btnElegir2"
                style="@style/BotonJuego"
                android:layout_width="180dp"
                android:layout_height="@dimen/alto_boton_pequeno"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_verde"
                android:text="@string/elegir"
                android:textSize="@dimen/texto_normal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layTarjeta3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="1"
            android:background="@drawable/panel_crema"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/imgModo3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/topo_normal_08_dorado" />
                <ImageView
                    android:id="@+id/imgCorazon1"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|start"
                    android:src="@drawable/corazon_lleno" />
                <ImageView
                    android:id="@+id/imgCorazon2"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|end"
                    android:src="@drawable/corazon_lleno" />
            </FrameLayout>

            <TextView
                android:id="@+id/lblTitulo3"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/infinito"
                android:textSize="@dimen/texto_grande" />

            <TextView
                android:id="@+id/lblDesc3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:minLines="2"
                android:text="@string/infinito_desc"
                android:textColor="@color/marron"
                android:textSize="@dimen/texto_pequeno" />

            <TextView
                android:id="@+id/btnElegir3"
                style="@style/BotonJuego"
                android:layout_width="180dp"
                android:layout_height="@dimen/alto_boton_pequeno"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_verde"
                android:text="@string/elegir"
                android:textSize="@dimen/texto_normal" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
