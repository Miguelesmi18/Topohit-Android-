<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila del historial de partidas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginTop="6dp"
    android:background="@drawable/fila"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingRight="14dp">

    <TextView
        android:id="@+id/lblFecha"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:textColor="@color/marron"
        android:textSize="@dimen/texto_pequeno" />

    <TextView
        android:id="@+id/lblModo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:textColor="@color/marron"
        android:textSize="@dimen/texto_pequeno"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lblDificultad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/marron"
        android:textSize="@dimen/texto_pequeno" />

    <TextView
        android:id="@+id/lblPuntos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/marron"
        android:textSize="@dimen/texto_pequeno" />

    <TextView
        android:id="@+id/lblResultado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:textColor="@color/marron"
        android:textSize="@dimen/texto_pequeno" />
</LinearLayout>
