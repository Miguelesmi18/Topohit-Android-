<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_partida_normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/margen_pequeno">

        <!-- Barra de arriba: atrás y título -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnAtras"
                style="@style/BotonRedondo"
                android:text="@string/atras" />

            <TextView
                android:id="@+id/lblTitulo"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/crear_cuenta" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:orientation="horizontal">

            <!-- Datos de la cuenta -->
            <LinearLayout
                android:id="@+id/layPanelDatos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/margen_pequeno"
                android:layout_weight="1"
                android:background="@drawable/panel_crema"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <EditText
                    android:id="@+id/txtUsuario"
                    style="@style/Campo"
                    android:layout_marginBottom="14dp"
                    android:hint="@string/usuario"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/txtContrasena"
                    style="@style/Campo"
                    android:layout_marginBottom="14dp"
                    android:hint="@string/contrasena"
                    android:inputType="textPassword" />

                <EditText
                    android:id="@+id/txtRepetir"
                    style="@style/Campo"
                    android:layout_marginBottom="22dp"
                    android:hint="@string/repetir_contrasena"
                    android:inputType="textPassword" />

                <TextView
                    android:id="@+id/btnCrear"
                    style="@style/BotonJuego"
                    android:layout_width="match_parent"
                    android:background="@drawable/btn_naranja"
                    android:text="@string/crear_cuenta_mayus" />

                <TextView
                    android:id="@+id/lblNota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/al_crear"
                    android:textColor="@color/marron"
                    android:textSize="@dimen/texto_pequeno" />
            </LinearLayout>

            <!-- Avatar -->
            <LinearLayout
                android:id="@+id/layPanelAvatar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/panel_crema"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/lblAvatar"
                    style="@style/Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/elige_avatar"
                    android:textSize="@dimen/texto_titulo_pequeno" />

                <include
                    android:id="@+id/selAvatares"
                    layout="@layout/selector_avatares"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/lblNotaAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/nota_avatares"
                    android:textColor="@color/marron"
                    android:textSize="@dimen/texto_pequeno" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/prgCargando"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
