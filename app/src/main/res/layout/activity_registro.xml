<?xml version="1.0" encoding="utf-8"?>
<!-- Crear cuenta: los datos a la izquierda y la rejilla de avatares a la derecha -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ImgRegistroFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_partida_normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/margen_pequeno">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/BtnRegistroAtras"
                style="@style/BotonRedondo"
                android:contentDescription="@string/volver"
                android:text="@string/atras" />

            <TextView
                android:id="@+id/LblRegistroCabecera"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:shadowColor="@color/blanco"
                android:shadowRadius="8"
                android:text="@string/crear_cuenta" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/LayRegistroDatos"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/margen_pequeno"
                android:layout_weight="1"
                android:background="@drawable/panel_crema"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/relleno_panel">

                <EditText
                    android:id="@+id/TxtRegistroUsuario"
                    style="@style/Campo"
                    android:layout_marginBottom="@dimen/separacion"
                    android:autofillHints="username"
                    android:hint="@string/usuario"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/TxtRegistroContrasena"
                    style="@style/Campo"
                    android:layout_marginBottom="@dimen/separacion"
                    android:autofillHints="password"
                    android:hint="@string/contrasena"
                    android:inputType="textPassword" />

                <EditText
                    android:id="@+id/TxtRegistroRepetir"
                    style="@style/Campo"
                    android:layout_marginBottom="@dimen/margen"
                    android:autofillHints="password"
                    android:hint="@string/repetir_contrasena"
                    android:inputType="textPassword" />

                <TextView
                    android:id="@+id/BtnRegistroCrear"
                    style="@style/BotonJuego"
                    android:layout_width="match_parent"
                    android:background="@drawable/btn_naranja"
                    android:text="@string/crear_cuenta_mayus" />

                <TextView
                    android:id="@+id/LblRegistroNota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margen_pequeno"
                    android:text="@string/al_crear"
                    android:textColor="@color/marron"
                    android:textSize="@dimen/texto_pequeno" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LayRegistroAvatar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/panel_crema"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/relleno_panel_pequeno">

                <TextView
                    android:id="@+id/LblRegistroAvatar"
                    style="@style/Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/elige_avatar"
                    android:textSize="@dimen/texto_titulo_pequeno" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/LstRegistroAvatares"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/separacion_pequena"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/LblRegistroNotaAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/nota_avatares"
                    android:textColor="@color/marron"
                    android:textSize="@dimen/texto_pequeno" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/PrgRegistroCargando"
        android:layout_width="@dimen/cargando"
        android:layout_height="@dimen/cargando"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
