<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila de Mis récords -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layFila"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/fila"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingRight="20dp">

    <ImageView
        android:id="@+id/imgIcono"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/estrella_llena" />

    <TextView
        android:id="@+id/lblNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/marron"
        android:textSize="@dimen/texto_normal" />

    <TextView
        android:id="@+id/lblDetalle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:textColor="@color/marron"
        android:textSize="@dimen/texto_pequeno" />

    <TextView
        android:id="@+id/lblPuntos"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:gravity="end"
        android:textColor="@color/marron"
        android:textSize="@dimen/texto_normal" />
</LinearLayout>
