<?xml version="1.0" encoding="utf-8"?>
<!-- Elegir la dificultad de Infinito: las 3 tarjetas salen de un RecyclerView en rejilla -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ImgDificultadFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_partida_normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/margen_pequeno">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/BtnDificultadAtras"
                style="@style/BotonRedondo"
                android:contentDescription="@string/volver"
                android:text="@string/atras" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/LblDificultadCabecera"
                    style="@style/Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="@color/blanco"
                    android:shadowRadius="8"
                    android:text="@string/infinito" />

                <TextView
                    style="@style/TextoSobreFondo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/infinito_desc"
                    android:textSize="@dimen/texto_normal" />
            </LinearLayout>
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/LstDificultades"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/margen_tarjetas"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:layout_marginRight="@dimen/margen_tarjetas"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/LblDificultadVacio"
        style="@style/TextoSobreFondo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/dificultad_reintentar"
        android:textSize="@dimen/texto_grande"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/PrgDificultadCargando"
        android:layout_width="@dimen/cargando"
        android:layout_height="@dimen/cargando"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>
