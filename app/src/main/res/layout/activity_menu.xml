<?xml version="1.0" encoding="utf-8"?>
<!-- Menú principal: avatar y saludo, ¡JUGAR!, ranking, perfil y las 3 temáticas -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ImgMenuFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_partida_normal" />

    <!-- Arriba a la izquierda: avatar y saludo -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margen_pequeno"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ImgMenuAvatar"
            android:layout_width="@dimen/avatar"
            android:layout_height="@dimen/avatar"
            android:background="@drawable/circulo_crema"
            android:contentDescription="@string/tu_avatar"
            android:padding="@dimen/separacion_pequena"
            android:src="@drawable/topo_normal_03_feliz" />

        <TextView
            android:id="@+id/LblMenuHola"
            style="@style/TextoSobreFondo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margen_pequeno"
            android:textSize="@dimen/texto_grande" />
    </LinearLayout>

    <!-- Arriba a la derecha: cómo jugar y ajustes -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/margen_pequeno"
        android:orientation="horizontal">

        <!-- Música: se pone o se quita con un toque (lo mismo que en Ajustes) -->
        <TextView
            android:id="@+id/BtnMenuMusica"
            style="@style/BotonRedondo"
            android:layout_marginEnd="@dimen/margen_pequeno"
            android:contentDescription="@string/musica_quitar"
            android:text="@string/icono_musica_si" />

        <TextView
            android:id="@+id/BtnMenuComoJugar"
            style="@style/BotonRedondo"
            android:layout_marginEnd="@dimen/margen_pequeno"
            android:contentDescription="@string/como_jugar"
            android:text="@string/icono_ayuda" />

        <TextView
            android:id="@+id/BtnMenuAjustes"
            style="@style/BotonRedondo"
            android:contentDescription="@string/ajustes"
            android:text="@string/icono_ajustes" />
    </LinearLayout>

    <!-- Centro: logo, botones y temáticas -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="@dimen/separacion_pequena"
        android:paddingBottom="@dimen/margen_pequeno">

        <ImageView
            android:id="@+id/ImgMenuLogo"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_normal" />

        <TextView
            android:id="@+id/BtnMenuJugar"
            style="@style/BotonJuego"
            android:layout_width="@dimen/ancho_boton_jugar"
            android:layout_height="@dimen/alto_boton_jugar"
            android:layout_marginTop="@dimen/separacion_pequena"
            android:background="@drawable/btn_naranja"
            android:text="@string/jugar"
            android:textSize="@dimen/texto_jugar" />

        <LinearLayout
            android:layout_width="@dimen/ancho_boton_jugar"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margen_pequeno"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/BtnMenuRanking"
                style="@style/BotonJuego"
                android:layout_width="0dp"
                android:layout_height="@dimen/alto_boton_pequeno"
                android:layout_marginEnd="@dimen/separacion_pequena"
                android:layout_weight="1"
                android:background="@drawable/btn_verde"
                android:text="@string/ranking"
                android:textSize="@dimen/texto_normal" />

            <TextView
                android:id="@+id/BtnMenuPerfil"
                style="@style/BotonJuego"
                android:layout_width="0dp"
                android:layout_height="@dimen/alto_boton_pequeno"
                android:layout_marginStart="@dimen/separacion_pequena"
                android:layout_weight="1"
                android:background="@drawable/btn_verde"
                android:text="@string/perfil"
                android:textSize="@dimen/texto_normal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LayMenuTematicas"
            android:layout_width="@dimen/ancho_tematicas"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/separacion"
            android:background="@drawable/panel_crema"
            android:orientation="vertical"
            android:paddingLeft="@dimen/margen"
            android:paddingTop="@dimen/separacion_pequena"
            android:paddingRight="@dimen/margen"
            android:paddingBottom="@dimen/separacion">

            <TextView
                android:id="@+id/LblMenuTematica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="@string/tematica"
                android:textColor="@color/marron"
                android:textSize="@dimen/texto_normal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_pequena"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/BtnMenuTemaNormal"
                    style="@style/BotonTema"
                    android:layout_marginEnd="@dimen/separacion_pequena"
                    android:background="@drawable/btn_verde"
                    android:textColor="@color/marron"
                    android:text="@string/normal" />

                <TextView
                    android:id="@+id/BtnMenuTemaHalloween"
                    style="@style/BotonTema"
                    android:layout_marginEnd="@dimen/separacion_pequena"
                    android:background="@drawable/btn_morado"
                    android:text="@string/halloween" />

                <TextView
                    android:id="@+id/BtnMenuTemaNavidad"
                    style="@style/BotonTema"
                    android:background="@drawable/btn_rojo"
                    android:text="@string/navidad" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
