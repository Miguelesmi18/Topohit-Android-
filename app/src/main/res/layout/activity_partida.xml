<?xml version="1.0" encoding="utf-8"?>
<!-- Partida de Infinito: barra de arriba (HUD), tablero de agujeros y las capas de pausa y ayuda -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ImgPartidaFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_partida_normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== Barra superior (HUD) ===== -->
        <LinearLayout
            android:id="@+id/LayPartidaHud"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_hud"
            android:layout_margin="@dimen/separacion_pequena"
            android:background="@drawable/panel_crema"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/separacion_pequena"
            android:paddingRight="@dimen/separacion_pequena"
            android:paddingBottom="@dimen/separacion_mini">

            <TextView
                android:id="@+id/BtnPartidaPausa"
                style="@style/BotonRedondo"
                android:layout_width="@dimen/boton_hud"
                android:layout_height="@dimen/boton_hud"
                android:contentDescription="@string/pausa"
                android:text="@string/icono_pausa"
                android:textSize="@dimen/texto_normal" />

            <ImageView
                android:layout_width="@dimen/icono_hud"
                android:layout_height="@dimen/icono_hud"
                android:layout_marginStart="@dimen/margen_pequeno"
                android:contentDescription="@string/puntos"
                android:src="@drawable/estrella_llena" />

            <TextView
                android:id="@+id/LblPartidaPuntos"
                android:layout_width="@dimen/ancho_puntos_hud"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/separacion_mini"
                android:fontFamily="sans-serif-black"
                android:text="@string/cero"
                android:textColor="@color/marron"
                android:textSize="@dimen/texto_puntos_hud" />

            <!-- Vidas y velocidad -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/LblPartidaEtiquetaVidas"
                    style="@style/EtiquetaHud"
                    android:text="@string/vidas" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ImgPartidaCorazon"
                        android:layout_width="@dimen/corazon_ancho"
                        android:layout_height="@dimen/corazon_alto"
                        android:contentDescription="@string/vidas"
                        android:src="@drawable/corazon_lleno" />

                    <TextView
                        android:id="@+id/LblPartidaVidas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/separacion_mini"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/marron"
                        android:textSize="@dimen/texto_grande" />

                    <TextView
                        android:id="@+id/LblPartidaVelocidad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margen"
                        android:textColor="@color/marron"
                        android:textSize="@dimen/texto_pequeno"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Racha / combo -->
            <TextView
                android:id="@+id/LblPartidaCombo"
                android:layout_width="@dimen/ancho_combo"
                android:layout_height="@dimen/alto_combo"
                android:layout_marginStart="@dimen/separacion"
                android:background="@drawable/chip_naranja"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:textColor="@color/blanco"
                android:textSize="@dimen/texto_pequeno" />

            <!-- Récord de esta dificultad -->
            <LinearLayout
                android:layout_width="@dimen/ancho_record_hud"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/separacion"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/LblPartidaEtiquetaRecord"
                    style="@style/EtiquetaHud"
                    android:text="@string/record" />

                <TextView
                    android:id="@+id/LblPartidaRecord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/marron"
                    android:textSize="@dimen/texto_grande" />

                <TextView
                    android:id="@+id/LblPartidaDificultad"
                    style="@style/EtiquetaHud" />
            </LinearLayout>

            <TextView
                android:id="@+id/BtnPartidaAyuda"
                style="@style/BotonRedondo"
                android:layout_width="@dimen/boton_hud"
                android:layout_height="@dimen/boton_hud"
                android:contentDescription="@string/que_hace"
                android:text="@string/icono_ayuda"
                android:textSize="@dimen/texto_normal" />
        </LinearLayout>

        <!-- ===== Tablero: las filas de agujeros se crean desde Kotlin ===== -->
        <LinearLayout
            android:id="@+id/LayPartidaTablero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="@dimen/margen_tablero"
            android:paddingRight="@dimen/margen_tablero"
            android:paddingBottom="@dimen/separacion_pequena" />
    </LinearLayout>

    <!-- Mensajes grandes en el centro: 3, 2, 1, ¡YA!, ¡COMBO x2! -->
    <TextView
        android:id="@+id/LblPartidaMensaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="sans-serif-black"
        android:shadowColor="@color/marron"
        android:shadowDy="6"
        android:shadowRadius="6"
        android:textColor="@color/amarillo"
        android:textSize="@dimen/texto_mensaje"
        android:visibility="gone" />

    <!-- ===== Pausa ===== -->
    <FrameLayout
        android:id="@+id/LayPartidaPausa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/oscurecer"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/LayPartidaPanelPausa"
            android:layout_width="@dimen/ancho_panel_pausa"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/panel_crema"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/margen">

            <TextView
                android:id="@+id/LblPartidaPausa"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pausa" />

            <ImageView
                android:id="@+id/ImgPartidaTopoPausa"
                android:layout_width="@dimen/topo_pausa"
                android:layout_height="@dimen/topo_pausa"
                android:contentDescription="@null"
                android:src="@drawable/topo_normal_03_feliz" />

            <TextView
                android:id="@+id/BtnPartidaContinuar"
                style="@style/BotonJuego"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/margen_pequeno"
                android:background="@drawable/btn_verde"
                android:text="@string/continuar" />

            <TextView
                android:id="@+id/BtnPartidaReiniciar"
                style="@style/BotonJuego"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/margen_pequeno"
                android:background="@drawable/btn_naranja"
                android:text="@string/reiniciar" />

            <TextView
                android:id="@+id/BtnPartidaSalir"
                style="@style/BotonJuego"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/margen_pequeno"
                android:background="@drawable/btn_rojo"
                android:text="@string/salir" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Ayuda: qué hace cada topo (también pausa la partida) ===== -->
    <FrameLayout
        android:id="@+id/LayPartidaAyuda"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/oscurecer"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/LayPartidaPanelAyuda"
            android:layout_width="@dimen/ancho_panel_ayuda"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/panel_crema"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/margen_pequeno">

            <TextView
                android:id="@+id/LblPartidaAyuda"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/que_hace"
                android:textSize="@dimen/texto_titulo_pequeno" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_mini"
                android:background="@drawable/chip_naranja"
                android:paddingLeft="@dimen/separacion"
                android:paddingTop="@dimen/separacion_mini"
                android:paddingRight="@dimen/separacion"
                android:paddingBottom="@dimen/separacion_mini"
                android:text="@string/partida_pausa"
                android:textColor="@color/blanco"
                android:textSize="@dimen/texto_mini"
                android:textStyle="bold" />

            <LinearLayout style="@style/FilaAyuda">

                <ImageView
                    android:id="@+id/ImgPartidaAyudaNormal"
                    style="@style/ImagenAyuda"
                    android:contentDescription="@string/topo_normal" />

                <TextView
                    android:id="@+id/LblPartidaAyudaNormal"
                    style="@style/TextoAyuda" />
            </LinearLayout>

            <LinearLayout style="@style/FilaAyuda">

                <ImageView
                    android:id="@+id/ImgPartidaAyudaEnfadado"
                    style="@style/ImagenAyuda"
                    android:contentDescription="@string/topo_enfadado" />

                <TextView
                    android:id="@+id/LblPartidaAyudaEnfadado"
                    style="@style/TextoAyuda" />
            </LinearLayout>

            <LinearLayout style="@style/FilaAyuda">

                <ImageView
                    android:id="@+id/ImgPartidaAyudaDorado"
                    style="@style/ImagenAyuda"
                    android:contentDescription="@string/topo_dorado" />

                <TextView
                    android:id="@+id/LblPartidaAyudaDorado"
                    style="@style/TextoAyuda" />
            </LinearLayout>

            <LinearLayout style="@style/FilaAyuda">

                <ImageView
                    android:id="@+id/ImgPartidaAyudaBomba"
                    style="@style/ImagenAyuda"
                    android:contentDescription="@string/bomba" />

                <TextView
                    android:id="@+id/LblPartidaAyudaBomba"
                    style="@style/TextoAyuda"
                    android:text="@string/ayuda_bomba" />
            </LinearLayout>

            <TextView
                android:id="@+id/BtnPartidaCerrarAyuda"
                style="@style/BotonJuego"
                android:layout_width="@dimen/ancho_boton_mediano"
                android:layout_marginTop="@dimen/margen_pequeno"
                android:background="@drawable/btn_verde"
                android:text="@string/continuar" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
