<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_partida_normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== Barra superior (HUD) ===== -->
        <LinearLayout
            android:id="@+id/layHud"
            android:layout_width="match_parent"
            android:layout_height="@dimen/alto_hud"
            android:layout_margin="10dp"
            android:background="@drawable/panel_crema"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/btnPausa"
                style="@style/BotonRedondo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="II"
                android:textSize="@dimen/texto_normal" />

            <ImageView
                android:layout_width="@dimen/icono_hud"
                android:layout_height="@dimen/icono_hud"
                android:layout_marginStart="12dp"
                android:src="@drawable/estrella_llena" />

            <TextView
                android:id="@+id/lblPuntos"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-black"
                android:text="0"
                android:textColor="@color/marron"
                android:textSize="32sp" />

            <!-- Tiempo (Historia y Contrarreloj) -->
            <LinearLayout
                android:id="@+id/layTiempo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblEtiquetaTiempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tiempo"
                    android:textColor="@color/marron"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="24dp"
                        android:layout_weight="1"
                        android:background="@drawable/barra_fondo">

                        <View
                            android:id="@+id/vProgreso"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/barra_progreso" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/lblTiempo"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:fontFamily="sans-serif-black"
                        android:text="60 s"
                        android:textColor="@color/marron"
                        android:textSize="@dimen/texto_normal" />
                </LinearLayout>
            </LinearLayout>

            <!-- Vidas (Infinito) -->
            <LinearLayout
                android:id="@+id/layVidas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vidas"
                    android:textColor="@color/marron"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgCorazon"
                        android:layout_width="38dp"
                        android:layout_height="34dp"
                        android:src="@drawable/corazon_lleno" />

                    <TextView
                        android:id="@+id/lblVidas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-black"
                        android:text="x3"
                        android:textColor="@color/marron"
                        android:textSize="@dimen/texto_grande" />

                    <TextView
                        android:id="@+id/lblVelocidad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:text="Velocidad x1.0"
                        android:textColor="@color/marron"
                        android:textSize="@dimen/texto_pequeno"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Racha / combo -->
            <TextView
                android:id="@+id/lblCombo"
                android:layout_width="150dp"
                android:layout_height="44dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/chip_naranja"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="Racha 0"
                android:textColor="@color/blanco"
                android:textSize="@dimen/texto_pequeno" />

            <!-- Objetivo (o récord en Infinito) -->
            <LinearLayout
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblEtiquetaObjetivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/objetivo"
                    android:textColor="@color/marron"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblObjetivo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="300"
                    android:textColor="@color/marron"
                    android:textSize="@dimen/texto_grande" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnAyuda"
                style="@style/BotonRedondo"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="\?"
                android:textSize="@dimen/texto_normal" />
        </LinearLayout>

        <!-- ===== Tablero: las filas de agujeros se crean desde Kotlin ===== -->
        <LinearLayout
            android:id="@+id/layTablero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="110dp"
            android:paddingRight="110dp"
            android:paddingBottom="10dp" />
    </LinearLayout>

    <!-- Mensajes grandes en el centro: 3, 2, 1, ¡YA!, ¡COMBO x2! -->
    <TextView
        android:id="@+id/lblMensaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="sans-serif-black"
        android:shadowColor="@color/marron"
        android:shadowDy="6"
        android:shadowRadius="6"
        android:textColor="@color/amarillo"
        android:textSize="90sp"
        android:visibility="gone" />

    <!-- ===== Pausa ===== -->
    <FrameLayout
        android:id="@+id/layPausa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/oscurecer"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layPanelPausa"
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/panel_crema"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/lblPausa"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pausa" />

            <ImageView
                android:id="@+id/imgTopoPausa"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:src="@drawable/topo_normal_03_feliz" />

            <TextView
                android:id="@+id/btnContinuar"
                style="@style/BotonJuego"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_verde"
                android:text="@string/continuar" />

            <TextView
                android:id="@+id/btnReiniciar"
                style="@style/BotonJuego"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_naranja"
                android:text="@string/reiniciar" />

            <TextView
                android:id="@+id/btnSalir"
                style="@style/BotonJuego"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_rojo"
                android:text="@string/salir_menu" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Ayuda: qué hace cada topo ===== -->
    <FrameLayout
        android:id="@+id/layAyuda"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/oscurecer"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layPanelAyuda"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/panel_crema"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/lblAyuda"
                style="@style/Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/que_hace"
                android:textSize="@dimen/texto_titulo_pequeno" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/chip_naranja"
                android:paddingLeft="16dp"
                android:paddingTop="4dp"
                android:paddingRight="16dp"
                android:paddingBottom="4dp"
                android:text="II  PARTIDA EN PAUSA"
                android:textColor="@color/blanco"
                android:textSize="13sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/filaNormal"
                layout="@layout/fila_ayuda" />

            <include
                android:id="@+id/filaEnfadado"
                layout="@layout/fila_ayuda" />

            <include
                android:id="@+id/filaDorado"
                layout="@layout/fila_ayuda" />

            <include
                android:id="@+id/filaBomba"
                layout="@layout/fila_ayuda" />

            <TextView
                android:id="@+id/btnCerrarAyuda"
                style="@style/BotonJuego"
                android:layout_width="280dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_verde"
                android:text="@string/continuar" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
